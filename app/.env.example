# Google sign-in (OAuth "Web" client id, same one given to Supabase) and Cloudflare Turnstile site key.
# Leave the Turnstile key empty for local development (CAPTCHA is off locally).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_TURNSTILE_SITE_KEY=

# Public website address used in share links (EXPO_PUBLIC_WEB_BASE_URL + /activites/<id>).
# Leave empty until the website exists; the in-app link friendapp://activites/<id> works regardless.
EXPO_PUBLIC_WEB_BASE_URL=

# Play Store page of the app, linked from the website (header and "Disponible dans l'application" screens).
EXPO_PUBLIC_PLAY_STORE_URL=
